/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, sans-serif;
}

/* 导航栏 */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 52rpx 40rpx 20rpx;
  background: #f8f5ee;
}
.navbar .navbar-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}
.navbar .navbar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.navbar .navbar-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1a1a1a;
}
.navbar .navbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.navbar .navbar-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 分类 Tab */
.tabs {
  display: flex;
  padding: 0 40rpx;
  gap: 48rpx;
  background: #f8f5ee;
  margin-bottom: 8rpx;
}
.tabs .tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 16rpx;
}
.tabs .tab-item .tab-text {
  font-size: 30rpx;
  color: #666666;
}
.tabs .tab-item .tab-line {
  width: 40rpx;
  height: 4rpx;
  background: #2a6e44;
  border-radius: 2rpx;
  margin-top: 8rpx;
}
.tabs .tab-item.active .tab-text {
  color: #1a1a1a;
  font-weight: 600;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
  padding: 0 40rpx;
}

/* 通用卡片 */
.card {
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  /* 右侧竖排标签 */
}
.card .side-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #b82e2e;
  border-radius: 0 32rpx 0 16rpx;
  padding: 16rpx 14rpx 20rpx;
}
.card .side-tag .side-tag-text {
  color: #fff;
  font-size: 22rpx;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 5rpx;
}
.card .side-tag-sm {
  padding: 12rpx 12rpx 16rpx;
}
.card .side-tag-sm .side-tag-text {
  font-size: 20rpx;
}
.card .card-meta {
  margin-bottom: 12rpx;
}
.card .card-meta .meta-text {
  font-size: 24rpx;
  color: #666666;
}
.card .card-title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
  padding-right: 60rpx;
}
.card .card-title-xl {
  font-size: 72rpx;
}
.card .card-body {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 48rpx;
  margin-bottom: 24rpx;
  padding-right: 60rpx;
}
.card .card-footer {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.card .card-footer .card-more {
  font-size: 24rpx;
  color: #2a6e44;
}

/* 白卡 */
.card-white {
  background: #fff;
}

/* 中绿卡（鹿柴） */
.card-green-md {
  background: linear-gradient(150deg, #4a8a55 0%, #2a6e44 60%, #1a4a2e 100%);
  min-height: 280rpx;
}

/* 大绿卡（春江花月夜） */
.card-green-lg {
  background: linear-gradient(150deg, #3d7a4a 0%, #2a6e44 50%, #1a4a2e 100%);
  min-height: 380rpx;
}
.card-green-lg .featured-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}
.card-green-lg .card-en-box {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
}
.card-green-lg .card-en-box .card-en-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 38rpx;
}

/* 底部导航 */
.tabbar {
  display: flex;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
  padding: 16rpx 0 40rpx;
}
.tabbar .tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.tabbar .tab .tab-text {
  font-size: 24rpx;
  color: #666666;
}
.tabbar .tab .tab-text-active {
  color: #2a6e44;
  font-weight: 500;
}
.tabbar .tab-center .tab-center-btn {
  width: 80rpx;
  height: 80rpx;
  background: #2a6e44;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -20rpx;
}
.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #666666;
  font-size: 26rpx;
}
.card-author {
  font-size: 24rpx;
  color: #666666;
}