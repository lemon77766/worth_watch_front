/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f0e8;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 32rpx 20rpx;
  background-color: #f5f0e8;
}
.navbar .navbar-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c2c2c;
  letter-spacing: 4rpx;
}
.navbar .navbar-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.navbar .navbar-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
}

/* 分类 Tab */
.tabs {
  display: flex;
  padding: 0 32rpx;
  gap: 48rpx;
  background-color: #f5f0e8;
  margin-bottom: 8rpx;
}
.tabs .tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 12rpx;
}
.tabs .tab-item .tab-text {
  font-size: 30rpx;
  color: #888;
}
.tabs .tab-item .tab-line {
  width: 40rpx;
  height: 4rpx;
  background: #3a6b35;
  border-radius: 2rpx;
  margin-top: 6rpx;
}
.tabs .tab-item.active .tab-text {
  color: #2c2c2c;
  font-weight: bold;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
  padding: 0 24rpx;
}

/* 通用卡片 */
.card {
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  /* 右侧竖排标签 */
}
.card .card-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 12rpx;
}
.card .card-meta .meta-dynasty, .card .card-meta .meta-type {
  font-size: 22rpx;
  color: #888;
}
.card .card-meta .meta-dot {
  font-size: 22rpx;
  color: #888;
}
.card .card-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #2c2c2c;
  margin-bottom: 16rpx;
}
.card .card-title-lg {
  font-size: 52rpx;
}
.card .card-body {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 46rpx;
  margin-bottom: 20rpx;
}
.card .card-footer {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.card .card-footer .footer-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}
.card .card-footer .card-more {
  font-size: 22rpx;
  color: #3a6b35;
}
.card .card-footer .card-author {
  font-size: 22rpx;
  color: #888;
}
.card .card-footer .card-label {
  font-size: 18rpx;
  color: #888;
  letter-spacing: 1rpx;
}
.card .card-tag-right {
  position: absolute;
  top: 0;
  right: 0;
  background: #c0392b;
  border-radius: 0 24rpx 0 16rpx;
  padding: 12rpx 14rpx;
}
.card .card-tag-right .tag-vert {
  color: #fff;
  font-size: 20rpx;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 4rpx;
}

/* 白色卡片 */
.card-white {
  background: #fff;
}

/* 山水背景卡 */
.card-mountain {
  background: linear-gradient(160deg, #7a9e7e 0%, #4a6741 50%, #2d4a2a 100%);
  min-height: 280rpx;
}

/* 绿色大卡 */
.card-green {
  background: linear-gradient(150deg, #5a8f5a 0%, #3a6b35 60%, #2a5228 100%);
  min-height: 360rpx;
}
.card-green .card-featured-label {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}
.card-green .card-en-desc {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}
.card-green .card-en-desc .en-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 34rpx;
}

/* 暗色大卡 */
.card-dark {
  background: linear-gradient(160deg, #3a3020 0%, #1a1a0e 100%);
  min-height: 300rpx;
  background-image: radial-gradient(circle at 70% 60%, rgba(255, 200, 50, 0.15) 0%, transparent 60%), linear-gradient(160deg, #3a3020 0%, #1a1a0e 100%);
}

/* 底部 TabBar */
.tabbar {
  display: flex;
  background: #fff;
  padding: 16rpx 0 30rpx;
  border-top: 1rpx solid #f0f0f0;
}
.tabbar .tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.tabbar .tab-bar-item .tab-bar-text {
  font-size: 20rpx;
  color: #999;
}
.tabbar .tab-bar-item .active-text {
  color: #3a6b35;
}
.tabbar .tab-center .tab-center-btn {
  width: 80rpx;
  height: 80rpx;
  background: #3a6b35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -20rpx;
}