/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 24rpx;
  padding-top: 70rpx;
  background: #f8f5ee;
}
.navbar .navbar-left {
  width: 80rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.navbar .navbar-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #2a6e44;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* 作者头部 */
.author-header {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 40rpx;
  background: #fff;
  margin: 0 40rpx 24rpx;
  border-radius: 32rpx;
}
.author-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  border: 3rpx solid #e0d8c8;
  flex-shrink: 0;
}
.author-avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #2a6e44;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.author-avatar-placeholder .avatar-text {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
}
.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.author-info .author-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.author-info .author-dynasty {
  font-size: 28rpx;
  color: #666666;
}

/* 简介卡片 */
.author-desc-card {
  background: #fff;
  margin: 0 40rpx 24rpx;
  border-radius: 32rpx;
  padding: 36rpx;
}
.author-desc-card .desc-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}
.author-desc-card .desc-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 48rpx;
}

/* 诗词区 */
.poems-section {
  padding: 0 40rpx;
}
.poems-section .poems-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

/* 诗词卡片 */
.card {
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.card .side-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #2a6e44;
  border-radius: 0 32rpx 0 16rpx;
  padding: 16rpx 14rpx 20rpx;
}
.card .side-tag .side-tag-text {
  color: #fff;
  font-size: 22rpx;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 5rpx;
}
.card .card-meta {
  margin-bottom: 12rpx;
}
.card .card-meta .meta-text {
  font-size: 24rpx;
  color: #666666;
}
.card .card-title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  padding-right: 60rpx;
}
.card .card-body {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 48rpx;
  margin-bottom: 24rpx;
  padding-right: 60rpx;
}
.card .card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card .card-author {
  font-size: 24rpx;
  color: #666666;
}
.card .card-more {
  font-size: 24rpx;
  color: #2a6e44;
}
.card-white {
  background: #fff;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}
.empty-state .empty-text {
  font-size: 30rpx;
  color: #666666;
}
.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #666666;
  font-size: 26rpx;
}