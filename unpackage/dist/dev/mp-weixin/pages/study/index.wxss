/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, sans-serif;
}

/* 导航栏 */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 52rpx 40rpx 20rpx;
  background: #f8f5ee;
}
.navbar .navbar-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.navbar .navbar-search {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* 统一左右内边距 */
.pad {
  padding: 24rpx 40rpx 0;
}

/* ── 研习天数卡片 ── */
.days-card {
  background: #f5f3eb;
  border-radius: 32rpx;
  padding: 40rpx 48rpx;
  position: relative;
  overflow: hidden;
}
.days-card .days-left .days-label {
  display: block;
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 8rpx;
}
.days-card .days-left .days-num-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}
.days-card .days-left .days-num-row .days-num {
  font-size: 128rpx;
  font-weight: 700;
  color: #2a6e44;
  line-height: 1;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.days-card .days-left .days-num-row .days-unit {
  font-size: 32rpx;
  color: #666666;
  padding-bottom: 16rpx;
}
.days-card .days-wm {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
}
.days-card .days-wm .days-wm-text {
  font-size: 88rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.06);
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 10rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}

/* ── 数据统计 ── */
.stat-row {
  display: flex;
  gap: 24rpx;
}
.stat-row .stat-card {
  flex: 1;
  border-radius: 32rpx;
  padding: 36rpx 40rpx;
}
.stat-row .stat-card .stat-label {
  display: block;
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 12rpx;
}
.stat-row .stat-card .stat-num-row {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
}
.stat-row .stat-card .stat-num-row .stat-num {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.stat-row .stat-card .stat-num-row .c-green {
  color: #2a6e44;
}
.stat-row .stat-card .stat-num-row .c-red {
  color: #b82e2e;
}
.stat-row .stat-card .stat-num-row .stat-unit {
  font-size: 30rpx;
  color: #666666;
  padding-bottom: 10rpx;
}
.stat-row .bg-green {
  background: #e6f2e9;
}
.stat-row .bg-pink {
  background: #f8ebe4;
}

/* ── 模块标题 ── */
.mod-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.mod-hd .mod-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.mod-hd .mod-title-wrap .mod-bar {
  width: 8rpx;
  height: 44rpx;
  background: #2a6e44;
  border-radius: 4rpx;
}
.mod-hd .mod-title-wrap .mod-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.mod-hd .mod-action {
  font-size: 30rpx;
  color: #2a6e44;
}

/* ── 当前目标卡片 ── */
.goal-card {
  background: #e8e6e1;
  border-radius: 32rpx;
  padding: 40rpx 48rpx;
  position: relative;
  overflow: hidden;
}
.goal-card .goal-side-tag {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  background: #b82e2e;
  border-radius: 0 32rpx 0 12rpx;
  padding: 20rpx 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.goal-card .goal-side-tag .goal-side-text {
  color: #fff;
  font-size: 24rpx;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 6rpx;
}
.goal-card .goal-name {
  display: block;
  font-size: 52rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding-right: 72rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.goal-card .goal-desc {
  display: block;
  font-size: 32rpx;
  color: #444;
  line-height: 52rpx;
  margin-bottom: 32rpx;
  padding-right: 72rpx;
}
.goal-card .goal-prog-hd {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.goal-card .goal-prog-hd .goal-prog-label {
  font-size: 32rpx;
  color: #444;
}
.goal-card .goal-prog-hd .goal-prog-count {
  font-size: 32rpx;
  color: #2a6e44;
}
.goal-card .prog-track {
  width: 100%;
  height: 16rpx;
  background: #d0cec9;
  border-radius: 8rpx;
  overflow: hidden;
}
.goal-card .prog-track .prog-fill {
  height: 100%;
  background: #2a6e44;
  border-radius: 8rpx;
}

/* ── 课业卡片 ── */
.lesson-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.lesson-card .lesson-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #e6f2e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.lesson-card .lesson-info {
  flex: 1;
}
.lesson-card .lesson-info .lesson-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.lesson-card .lesson-info .lesson-hd .ltag {
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}
.lesson-card .lesson-info .lesson-hd .ltag .ltag-text {
  font-size: 26rpx;
}
.lesson-card .lesson-info .lesson-hd .ltag-light {
  background: #e6f2e9;
}
.lesson-card .lesson-info .lesson-hd .ltag-light-text {
  color: #2a6e44;
}
.lesson-card .lesson-info .lesson-hd .ltag-dark {
  background: #2a6e44;
}
.lesson-card .lesson-info .lesson-hd .ltag-dark-text {
  color: #fff;
}
.lesson-card .lesson-info .lesson-hd .lesson-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.lesson-card .lesson-info .lesson-sub {
  font-size: 30rpx;
  color: #666666;
}
.mt-s {
  margin-top: 24rpx;
}

/* ── 成就徽章 ── */
.badge-row {
  display: flex;
  gap: 32rpx;
}
.badge-row .badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.badge-row .badge-item .badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-row .badge-item .badge .badge-text {
  font-size: 32rpx;
  font-weight: 600;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 6rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.badge-row .badge-item .badge-on {
  background: #fdf8f0;
  border: 3rpx dashed #b82e2e;
}
.badge-row .badge-item .badge-on .badge-text-on {
  color: #b82e2e;
}
.badge-row .badge-item .badge-off {
  background: #f0f0f0;
  border: 3rpx dashed #ccc;
}
.badge-row .badge-item .badge-off .badge-text-off {
  color: #ccc;
}
.badge-row .badge-item .badge-status {
  font-size: 28rpx;
  color: #666666;
}
.badge-row .badge-item .badge-status-off {
  color: #999;
}

/* ── 底部导航 ── */
.tabbar {
  display: flex;
  background: #f8f5ee;
  border-top: 2rpx solid #e0e0e0;
  padding: 16rpx 0 40rpx;
}
.tabbar .tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.tabbar .tab .tab-text {
  font-size: 24rpx;
  color: #666666;
}
.tabbar .tab-active .tab-icon-bg {
  width: 56rpx;
  height: 56rpx;
  background: #2a6e44;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabbar .tab-active .tab-text-active {
  font-size: 24rpx;
  font-weight: 500;
  color: #2a6e44;
}