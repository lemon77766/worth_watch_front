/* 水平间距 */
/* 水平间距 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2e3328 0%, #232b20 50%, #1a2018 100%);
  background-attachment: fixed;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
  font-family: "PingFang SC", "Noto Sans SC", -apple-system, sans-serif;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}
.status-bar {
  height: 88rpx;
}
.top-subtitle {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

/* 导航行 */
.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.nav-row .nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-row .recitation-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 3rpx;
}

/* 标题 */
.poem-header {
  text-align: center;
  margin-bottom: 72rpx;
}
.poem-header .poem-title {
  display: block;
  font-size: 96rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 16rpx;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  margin-bottom: 20rpx;
}
.poem-header .poem-author {
  display: block;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 4rpx;
}

/* 诗句 */
.lines-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 8rpx;
}
.lines-area .poem-line {
  display: block;
  font-size: 52rpx;
  line-height: 100rpx;
  letter-spacing: 6rpx;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  transition: color 0.3s, font-size 0.3s;
}
.lines-area .line-active {
  color: #fff;
  font-size: 58rpx;
  font-weight: 600;
}
.lines-area .line-dim {
  color: rgba(255, 255, 255, 0.28);
}

/* 进度条 */
.progress-wrap {
  padding: 32rpx 0 16rpx;
}
.progress-wrap .time-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-wrap .time-row .time-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  font-variant-numeric: tabular-nums;
}
.progress-wrap .progress-track {
  width: 100%;
  height: 40rpx;
  /* 加大触摸区域 */
  display: flex;
  align-items: center;
  position: relative;
  cursor: pointer;
}
.progress-wrap .progress-track::before {
  /* 可视细线背景 */
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 2rpx;
}
.progress-wrap .progress-track .progress-fill {
  position: absolute;
  left: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 2rpx;
  transition: width 0.1s linear;
}
.progress-wrap .progress-track .progress-thumb {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #fff;
  transform: translateX(-50%);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
  transition: left 0.1s linear;
}

/* 播放按钮 */
.play-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 30rpx rgba(0, 0, 0, 0.45);
  flex-shrink: 0;
}
.play-btn .tri-play {
  width: 0;
  height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 30rpx solid #1a2018;
  margin-left: 6rpx;
}
.play-btn .pause-bars {
  display: flex;
  gap: 8rpx;
}
.play-btn .pause-bars .pause-bar {
  width: 8rpx;
  height: 32rpx;
  background: #1a2018;
  border-radius: 4rpx;
}
.play-btn .loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #1a2018;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
to {
    transform: rotate(360deg);
}
}
/* 音色 / 播放 / 倍速 选择行 */
.opt-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.opt-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.opt-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}
.opt-toggle .opt-toggle-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.opt-toggle .opt-toggle-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid rgba(255, 255, 255, 0.5);
  transition: transform 0.2s;
}
.opt-toggle .arrow-open {
  transform: rotate(180deg);
}
.speed-toggle .opt-toggle-text {
  min-width: 64rpx;
  text-align: center;
}
.opt-panel {
  margin-top: 16rpx;
  background: rgba(30, 40, 28, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 8rpx 0;
  min-width: 320rpx;
}
.opt-panel .opt-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  gap: 16rpx;
}
.opt-panel .opt-item .opt-item-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
}
.opt-panel .opt-item .opt-item-name-active {
  color: #fff;
}
.opt-panel .opt-item .opt-item-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  flex: 1;
}
.opt-panel .opt-item .opt-check {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(42, 110, 68, 0.9);
}
.opt-panel .opt-item-active {
  background: rgba(42, 110, 68, 0.25);
}