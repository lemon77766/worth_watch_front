/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", -apple-system, sans-serif;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 52rpx 36rpx 20rpx;
}
.navbar .nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(42, 110, 68, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar .nav-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}
.content {
  padding: 24rpx 40rpx 0;
}
.update-date {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 40rpx;
}
.section {
  margin-bottom: 48rpx;
}
.section .sec-hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.section .sec-hd .sec-bar {
  width: 6rpx;
  height: 40rpx;
  background: #2a6e44;
  border-radius: 3rpx;
}
.section .sec-hd .sec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", serif;
}
.section .sec-body {
  font-size: 28rpx;
  color: #666;
  line-height: 52rpx;
  text-indent: 2em;
}
.contact-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 16rpx;
}
.contact-card .contact-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  margin-bottom: 20rpx;
}
.contact-card .contact-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 48rpx;
}