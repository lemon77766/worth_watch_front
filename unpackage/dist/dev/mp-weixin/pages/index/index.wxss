/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, sans-serif;
}

/* 搜索弹窗 */
.search-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  padding-top: 120rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 40rpx;
  border-radius: 24rpx;
  padding: 20rpx 30rpx;
}
.search-input {
  flex: 1;
  font-size: 32rpx;
  height: 72rpx;
}
.search-btn {
  font-size: 32rpx;
  color: #2a6e44;
  padding-left: 20rpx;
}
.search-results {
  max-height: calc(100vh - 300rpx);
  margin-top: 24rpx;
  padding: 0 40rpx;
}
.search-section {
  margin-bottom: 24rpx;
}
.search-section-title {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}
.search-author-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.search-author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.search-author-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #2a6e44;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.search-author-avatar-placeholder .search-avatar-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
.search-author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.search-author-info .search-author-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.search-author-info .search-author-dynasty {
  font-size: 24rpx;
  color: #999;
}
.search-card {
  margin-bottom: 16rpx;
}
.search-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #666666;
  font-size: 28rpx;
}
.search-hint {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 导航栏 */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 40rpx;
  padding-top: 70rpx;
  background: #f8f5ee;
  position: relative;
  z-index: 10;
}
.navbar .navbar-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #2a6e44;
  letter-spacing: 2rpx;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.navbar .navbar-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #1a1a1a;
}
.navbar .navbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.navbar .navbar-search {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* ── Banner ── */
.banner {
  margin: 62rpx 40rpx 0;
}
.banner .banner-inner {
  border-radius: 40rpx;
  height: 760rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(210, 155, 70, 0.9) 0%, rgba(140, 160, 90, 0.85) 45%, rgba(50, 90, 65, 0.95) 100%);
  background-size: cover;
  background-position: center;
}
.banner .banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.12));
  z-index: 1;
  pointer-events: none;
}
.banner .banner-tag-tl {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 3;
}
.banner .banner-tag-tr {
  position: absolute;
  top: 0;
  right: 28rpx;
  z-index: 3;
  width: 60rpx;
  background: #b82e2e;
  border-radius: 0 0 12rpx 12rpx;
  padding: 12rpx 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner .banner-tag-tr .banner-tag-tr-text {
  color: #fff;
  font-size: 22rpx;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 6rpx;
  font-weight: 400;
}
.banner .banner-watermark {
  position: absolute;
  right: -30rpx;
  top: 50%;
  transform: translateY(-50%) rotate(90deg);
  z-index: 2;
  pointer-events: none;
}
.banner .banner-watermark .banner-watermark-text {
  font-size: 24rpx;
  color: #aaa;
  letter-spacing: 8rpx;
  opacity: 0.6;
}
.banner .banner-body {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-60%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.banner .banner-body .banner-title {
  font-weight: 700;
  color: #2a6e44;
  letter-spacing: 10rpx;
  line-height: 1.2;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
  text-align: center;
  word-break: break-all;
}
.banner .banner-body .banner-author {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 16rpx;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
}
.banner .banner-body .banner-poem {
  font-size: 34rpx;
  color: #2a2a2a;
  line-height: 56rpx;
  letter-spacing: 2rpx;
  text-align: center;
}
.banner .banner-btn-row {
  position: absolute;
  bottom: 48rpx;
  left: 0;
  right: 0;
  z-index: 3;
  display: flex;
  justify-content: center;
}
.banner .banner-btn-row .banner-btn {
  background: #2a6e44;
  border-radius: 24rpx;
  width: 320rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.banner .banner-btn-row .banner-btn .banner-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}
.banner-loading {
  margin: 40rpx 40rpx 0;
  height: 760rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, rgba(210, 155, 70, 0.5) 0%, rgba(50, 90, 65, 0.5) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

/* 红色标签 */
.tag-red {
  display: inline-flex;
  background: #b82e2e;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
}
.tag-red .tag-red-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

/* Section */
.section {
  padding: 48rpx 40rpx 0;
}
.section .section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.section .section-hd .section-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.section .section-hd .section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.section .section-hd .section-more .section-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 选集大卡片 */
.col-main-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 48rpx;
  display: flex;
  align-items: center;
