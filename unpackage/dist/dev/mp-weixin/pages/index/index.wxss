}

/* 时令特辑 */
.special-card {
  background: #e6f2e9;
  border-radius: 40rpx;
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.special-card .special-left {
  flex: 1;
  margin-right: 32rpx;
}
.special-card .special-left .special-tag {
  margin-bottom: 24rpx;
}
.special-card .special-left .special-title {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  color: #65b380;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.special-card .special-left .special-desc {
  display: block;
  font-size: 30rpx;
  color: #444;
  line-height: 48rpx;
}
.special-card .special-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2a6e44;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(42, 110, 68, 0.3);
}

/* ── 文库 Tab ── */
.lib-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  background: #f8f5ee;
  margin-bottom: 8rpx;
}
.lib-tabs .lib-tabs-left {
  display: flex;
  gap: 48rpx;
}
.lib-tabs .lib-tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 16rpx;
}
.lib-tabs .lib-tab-item .lib-tab-text {
  font-size: 30rpx;
  color: #666666;
}
.lib-tabs .lib-tab-item .lib-tab-line {
  width: 40rpx;
  height: 4rpx;
  background: #2a6e44;
  border-radius: 2rpx;
  margin-top: 8rpx;
}
.lib-tabs .lib-tab-active .lib-tab-text {
  color: #1a1a1a;
  font-weight: 600;
}
.lib-tabs .batch-btn-inline {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(42, 110, 68, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.lib-tabs .batch-btn-inline.active {
  background: #2a6e44;
}

/* 子分类 Tab */
.sub-tabs {
  display: flex;
  padding: 0 40rpx 16rpx;
  gap: 24rpx;
  flex-wrap: wrap;
}
.sub-tabs .sub-tab-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #f0ece4;
  font-size: 28rpx;
  color: #666666;
}
.sub-tabs .sub-tab-item.sub-tab-active {
  background: #2a6e44;
  color: #fff;
}

/* 文库卡片 */
.card {
  border-radius: 32rpx;
  padding: 40rpx;
  padding-left: 100rpx;
  margin: 0 40rpx 24rpx;
  position: relative;
  overflow: hidden;
}
.card .side-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #b82e2e;
  border-radius: 0 32rpx 0 16rpx;
  padding: 16rpx 14rpx 20rpx;
}
.card .side-tag .side-tag-text {
  color: #fff;
  font-size: 22rpx;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 5rpx;
}
.card .side-tag-sm {
  padding: 12rpx 12rpx 16rpx;
}
.card .side-tag-sm .side-tag-text {
  font-size: 20rpx;
}
.card .card-meta {
  margin-bottom: 12rpx;
}
.card .card-meta .meta-text {
  font-size: 24rpx;
  color: #666666;
}
.card .card-title {
  display: block;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
