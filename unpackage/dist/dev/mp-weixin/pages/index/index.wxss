  border-radius: 20rpx;
  flex-shrink: 0;
}

/* 热门作者 */
.author-row {
  display: flex;
  gap: 24rpx;
}
.author-row .author-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.author-row .author-card .author-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #2a2a2a;
