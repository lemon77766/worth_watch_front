/* ── 页面容器 ── */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── 导航栏 56px ── */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 40rpx;
  padding-top: 44rpx;
  /* 状态栏 */
  background: #f8f5ee;
}
.navbar .navbar-title {
  font-size: 36rpx;
  /* 18px */
  font-weight: 500;
  color: #2a6e44;
  letter-spacing: 2rpx;
}
.navbar .navbar-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1a1a1a;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* ── Banner 380px ── */
.banner {
  margin: 48rpx 40rpx 0;
  /* 下半部分白色渐变遮罩 */
  /* 左上标签 */
  /* 右侧竖排标签 */
  /* 右侧水印 */
  /* 核心文字区 */
  /* 按钮 */
}
.banner .banner-inner {
  border-radius: 40rpx;
  height: 760rpx;
  position: relative;
  overflow: hidden;
  /* 暖橙+青绿色调模拟秋日风景 */
  background: linear-gradient(180deg, rgba(210, 155, 70, 0.9) 0%, rgba(140, 160, 90, 0.85) 45%, rgba(50, 90, 65, 0.95) 100%);
}
.banner .banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.12));
  z-index: 1;
  pointer-events: none;
}
.banner .banner-tag-tl {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 3;
}
.banner .banner-tag-tr {
  position: absolute;
  top: 0;
  right: 28rpx;
  z-index: 3;
  width: 100rpx;
  background: #b82e2e;
  border-radius: 0 0 16rpx 16rpx;
  padding: 20rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner .banner-tag-tr .banner-tag-tr-text {
  color: #fff;
  font-size: 28rpx;
  /* 14px */
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 6rpx;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.banner .banner-watermark {
  position: absolute;
  right: -30rpx;
  top: 50%;
  transform: translateY(-50%) rotate(90deg);
  z-index: 2;
  pointer-events: none;
}
.banner .banner-watermark .banner-watermark-text {
  font-size: 24rpx;
  color: #aaa;
  letter-spacing: 8rpx;
  opacity: 0.6;
}
.banner .banner-body {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-60%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.banner .banner-body .banner-title {
  font-size: 96rpx;
  /* 48px */
  font-weight: 700;
  color: #2a6e44;
  letter-spacing: 10rpx;
  line-height: 1.1;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.banner .banner-body .banner-author {
  font-size: 34rpx;
  /* 17px */
  font-weight: 400;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 16rpx;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.banner .banner-body .banner-poem {
  font-size: 34rpx;
  /* 17px */
  font-weight: 400;
  color: #2a2a2a;
  line-height: 56rpx;
  letter-spacing: 2rpx;
  text-align: center;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.banner .banner-btn-row {
  position: absolute;
  bottom: 48rpx;
  left: 0;
  right: 0;
  z-index: 3;
  display: flex;
  justify-content: center;
}
.banner .banner-btn-row .banner-btn {
  background: #2a6e44;
  border-radius: 24rpx;
  width: 320rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.banner .banner-btn-row .banner-btn .banner-btn-text {
  color: #fff;
  font-size: 32rpx;
  /* 16px */
  font-weight: 500;
  letter-spacing: 4rpx;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── 通用红色标签 ── */
.tag-red {
  display: inline-flex;
  background: #b82e2e;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
}
.tag-red .tag-red-text {
  color: #fff;
  font-size: 26rpx;
  /* 13px */
  font-weight: 500;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── Section ── */
.section {
  padding: 48rpx 40rpx 0;
}
.section .section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.section .section-hd .section-title {
  font-size: 48rpx;
  /* 24px */
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.section .section-hd .section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.section .section-hd .section-more .section-more-text {
  font-size: 30rpx;
  /* 15px */
  color: #2a6e44;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── 选集大卡片 ── */
.col-main-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.col-main-card .col-main-left {
  flex: 1;
  margin-right: 24rpx;
}
.col-main-card .col-main-left .col-label {
  display: block;
  font-size: 26rpx;
  /* 13px */
  color: #666666;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.col-main-card .col-main-left .col-name {
  display: block;
  font-size: 44rpx;
  /* 22px */
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.col-main-card .col-main-left .col-desc {
  display: block;
  font-size: 30rpx;
  /* 15px */
  color: #666666;
  line-height: 44rpx;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.col-main-card .col-main-right {
  width: 160rpx;
  height: 220rpx;
  background: #f0efe9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 0;
  overflow: hidden;
  flex-shrink: 0;
}
.col-main-card .col-main-right .col-right-topbar {
  width: 100%;
  height: 8rpx;
  background: #2a6e44;
  margin-bottom: 24rpx;
}
.col-main-card .col-main-right .col-right-text {
  color: #2a6e44;
  font-size: 36rpx;
  /* 18px */
  font-weight: 500;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 8rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── 选集双小卡片 ── */
.col-small-row {
  display: flex;
  gap: 24rpx;
}
.col-small-row .col-small-card {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 36rpx;
}
.col-small-row .col-small-card .col-small-name {
  display: block;
  font-size: 40rpx;
  /* 20px */
  font-weight: 600;
  color: #1a1a1a;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.col-small-row .col-small-card .col-small-desc {
  display: block;
  font-size: 28rpx;
  /* 14px */
  color: #666666;
  line-height: 40rpx;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── 热门作者 ── */
.author-row {
  display: flex;
  gap: 24rpx;
}
.author-row .author-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.author-row .author-card .author-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #2a2a2a;
  border: 2rpx solid #e0e0e0;
  margin-bottom: 24rpx;
}
.author-row .author-card .author-name {
  font-size: 40rpx;
  /* 20px */
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.author-row .author-card .author-sub {
  font-size: 28rpx;
  /* 14px */
  color: #666666;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}

/* ── 时令特辑 ── */
.special-card {
  background: #e6f2e9;
  border-radius: 40rpx;
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.special-card .special-left {
  flex: 1;
  margin-right: 32rpx;
}
.special-card .special-left .special-tag {
  margin-bottom: 24rpx;
}
.special-card .special-left .special-title {
  display: block;
  font-size: 64rpx;
  /* 32px */
  font-weight: 600;
  color: #65b380;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.special-card .special-left .special-desc {
  display: block;
  font-size: 30rpx;
  /* 15px */
  color: #444;
  line-height: 48rpx;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.special-card .special-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2a6e44;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(42, 110, 68, 0.3);
}

/* ── 底部导航 ── */
.tabbar {
  display: flex;
  background: #f8f5ee;
  border-top: 2rpx solid #e0e0e0;
  padding: 16rpx 0 40rpx;
}
.tabbar .tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.tabbar .tab .tab-text {
  font-size: 24rpx;
  /* 12px */
  color: #666666;
  font-weight: 400;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}
.tabbar .active-tab .tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: #2a6e44;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabbar .active-tab .active-tab-text {
  font-size: 24rpx;
  /* 12px */
  font-weight: 500;
  color: #2a6e44;
  font-family: "PingFang SC", "Noto Sans SC", "Source Han Sans CN", -apple-system, "Helvetica Neue", sans-serif;
}