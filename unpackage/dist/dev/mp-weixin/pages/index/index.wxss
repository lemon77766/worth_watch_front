}
.stat-row .bg-green {
  background: #e6f2e9;
}
.stat-row .bg-pink {
  background: #f8ebe4;
}
.mod-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.mod-hd .mod-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.mod-hd .mod-bar {
  width: 8rpx;
  height: 44rpx;
  background: #2a6e44;
  border-radius: 4rpx;
