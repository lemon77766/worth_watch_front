}
.col-main-card .col-main-right .col-right-text {
  color: #2a6e44;
  font-size: 36rpx;
  font-weight: 500;
  -webkit-writing-mode: vertical-rl;
          writing-mode: vertical-rl;
  letter-spacing: 8rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 双小卡片 */
.col-small-row {
  display: flex;
  gap: 24rpx;
}
.col-small-row .col-small-card {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 36rpx;
}
.col-small-row .col-small-card .col-small-name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  font-family: "STSong", "SimSun", "Songti SC", "Source Han Serif CN", serif;
}
.col-small-row .col-small-card .col-small-desc {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 40rpx;
}

/* 热门诗词 */
.hot-poems-scroll {
  white-space: nowrap;
}
.hot-poems-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.hot-poem-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.hot-poem-card .hot-poem-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #e8e4da;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #999;
