/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 24rpx;
  padding-top: 70rpx;
  background: #f8f5ee;
}
.navbar .navbar-left {
  width: 80rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.navbar .navbar-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
  padding: 0 32rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-state .empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(42, 110, 68, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.empty-state .empty-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.empty-state .empty-hint {
  font-size: 26rpx;
  color: #888;
  margin-top: 12rpx;
}

/* 合集卡片 */
.project-card {
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  /* 操作按钮区 */
}
.project-card.is-selected {
  border-left: 6rpx solid #2a6e44;
}
.project-card .card-main {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}
.project-card .project-index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #f0ede6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.project-card .project-index .index-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #888;
}
.project-card .project-index.index-active {
  background: #2a6e44;
}
.project-card .project-index.index-active .index-text {
  color: #fff;
}
.project-card .project-info {
  flex: 1;
  overflow: hidden;
}
.project-card .project-info .project-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.project-card .project-info .project-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.project-card .project-info .selected-tag {
  background: rgba(42, 110, 68, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}
.project-card .project-info .selected-tag .selected-tag-text {
  font-size: 20rpx;
  color: #2a6e44;
  font-weight: 500;
}
.project-card .project-info .project-meta-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.project-card .project-info .project-meta {
  font-size: 24rpx;
  color: #888;
}
.project-card .project-info .meta-dot {
  font-size: 22rpx;
  color: #ccc;
  margin: 0 4rpx;
}
.project-card .arrow-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.project-card .card-actions {
  display: flex;
  align-items: center;
  border-top: 1rpx solid #f5f2ec;
  background: #fdfbf7;
  padding: 0 8rpx;
}
.project-card .action-divider {
  width: 1rpx;
  height: 36rpx;
  background: #eee;
}
.project-card .action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 0;
}
.project-card .action-btn .action-btn-text {
  font-size: 26rpx;
  font-weight: 500;
}
.project-card .action-btn.select-btn .action-btn-text {
  color: #2a6e44;
}
.project-card .action-btn.select-btn .action-btn-text.is-current {
  color: #888;
}
.project-card .action-btn .rename-text {
  color: #e6a23c;
}
.project-card .action-btn .delete-text {
  color: #b82e2e;
}