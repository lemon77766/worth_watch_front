/* 水平间距 */
/* 水平间距 */
.page {
  min-height: 100vh;
  background-color: #f8f5ee;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
}

/* 水印 */
.watermark {
  position: absolute;
  font-size: 600rpx;
  font-weight: bold;
  color: rgba(0, 0, 0, 0.06);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -55%);
  pointer-events: none;
  z-index: 0;
  line-height: 1;
}

/* Logo */
.logo-wrap {
  z-index: 1;
  margin-bottom: 48rpx;
}
.logo-outer {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e8e4da, #f8f5ee);
  box-shadow: 8rpx 8rpx 20rpx rgba(0, 0, 0, 0.12), -4rpx -4rpx 12rpx rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-inner {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #2a6e44;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-text {
  color: #fff;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
}

/* 英文副标题 */
.en-sub {
  z-index: 1;
  font-size: 22rpx;
  color: #888888;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}

/* 主标题 */
.main-title {
  z-index: 1;
  font-size: 72rpx;
  font-weight: bold;
  color: #2a6e44;
  letter-spacing: 10rpx;
  margin-bottom: 24rpx;
}

/* 副标题 */
.sub-wrap {
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}
.sub-wrap .sub-text {
  font-size: 28rpx;
  color: #888888;
  line-height: 50rpx;
  text-align: center;
}

/* 底部区域 */
.bottom-area {
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

/* 登录按钮 */
.login-btn {
  width: 80%;
  height: 96rpx;
  background: #e5e7eb;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  box-shadow: none;
  transition: background 0.2s;
}
.login-btn.agreed {
  background: #2a6e44;
}
.login-btn.agreed .login-text {
  color: #fff;
}
.login-btn.agreed .wechat-icon {
  filter: brightness(10);
}
.login-btn.disabled {
  opacity: 1;
}
.login-btn .wechat-icon {
  font-size: 36rpx;
}
.login-btn .login-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 协议行 */
.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 80%;
}
.agreement-row .checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  background: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.agreement-row .checkbox.checked {
  border-color: #2a6e44;
}
.agreement-row .agreement-text-wrap {
  flex: 1;
  flex-wrap: wrap;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.agreement-row .agreement-text-wrap .agree-text {
  font-size: 22rpx;
  color: #888888;
  line-height: 38rpx;
}
.agreement-row .agreement-text-wrap .agree-link {
  font-size: 22rpx;
  color: #3b82f6;
  line-height: 38rpx;
}