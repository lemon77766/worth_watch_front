/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", -apple-system, sans-serif;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 52rpx 36rpx 20rpx;
}
.navbar .nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(42, 110, 68, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar .nav-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.stat-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 40rpx;
  background: #fff;
  margin: 0 40rpx;
  border-radius: 24rpx;
}
.stat-bar .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-bar .stat-item .stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #2a6e44;
  font-family: "STSong", "SimSun", "Songti SC", serif;
}
.stat-bar .stat-item .stat-label {
  font-size: 24rpx;
  color: #888;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}
.list {
  padding: 16rpx 40rpx 0;
}
.poem-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.poem-card .card-left {
  flex: 1;
}
.poem-card .card-left .card-tag {
  display: inline-flex;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}
.poem-card .card-left .card-tag .card-tag-text {
  color: #fff;
  font-size: 22rpx;
}
.poem-card .card-left .card-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  margin-bottom: 6rpx;
}
.poem-card .card-left .card-author {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.poem-card .card-left .card-preview {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 44rpx;
}
.poem-card .card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  padding-left: 16rpx;
}
.poem-card .card-right .fav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fdecea;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poem-card .card-right .card-type {
  font-size: 22rpx;
  color: #888;
  white-space: nowrap;
}