/* 水平间距 */
/* 水平间距 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f5ee;
  font-family: "PingFang SC", "Noto Sans SC", -apple-system, sans-serif;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 52rpx 36rpx 20rpx;
}
.navbar .nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(42, 110, 68, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar .nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 统计栏 */
.stat-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  padding: 32rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}
.stat-bar .stat-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.stat-bar .stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #2a6e44;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  line-height: 1;
}
.stat-bar .stat-label {
  font-size: 26rpx;
  color: #999;
}
.stat-bar .stat-seal {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #c05050;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
}
.stat-bar .stat-seal .seal-text {
  font-size: 36rpx;
  color: #c05050;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  font-weight: 700;
}
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-state .empty-seal {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid #c8c2b6;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}
.empty-state .empty-seal .empty-seal-text {
  font-size: 56rpx;
  color: #c8c2b6;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  font-weight: 700;
}
.empty-state .empty-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.empty-state .empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 列表 */
.list {
  padding: 24rpx 32rpx 0;
}
.poem-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 28rpx 0;
  margin-bottom: 16rpx;
  display: flex;
  align-items: stretch;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  /* 左侧装饰 */
  /* 最后一项隐藏连线 */
}
.poem-card .card-deco {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  flex-shrink: 0;
}
.poem-card .card-deco .deco-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2a6e44;
  flex-shrink: 0;
}
.poem-card .card-deco .deco-line {
  flex: 1;
  width: 2rpx;
  background: linear-gradient(to bottom, rgba(42, 110, 68, 0.25), transparent);
  margin-top: 8rpx;
}
.poem-card:last-child .deco-line {
  display: none;
}
.poem-card .card-body {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}
.poem-card .card-body .card-header {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 4rpx;
}
.poem-card .card-body .card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "STSong", "SimSun", "Songti SC", serif;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.poem-card .card-body .card-dynasty {
  font-size: 22rpx;
  color: #2a6e44;
  flex-shrink: 0;
}
.poem-card .card-body .card-author {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.poem-card .card-body .card-preview {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 44rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.poem-card .card-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
}