<view class="page"><view class="navbar"><view class="nav-btn" bindtap="{{b}}"><uni-icons wx:if="{{a}}" u-i="d86558fc-0" bind:__l="__l" u-p="{{a}}"/></view><text class="nav-title">我的收藏</text><view class="nav-btn"/></view><view class="stat-bar"><view class="stat-left"><text class="stat-num">{{c}}</text><text class="stat-label">首诗词收藏</text></view><view class="stat-seal"><text class="seal-text">藏</text></view></view><scroll-view scroll-y class="scroll-body"><view wx:if="{{d}}" class="empty-state"><view class="empty-seal"><text class="empty-seal-text">藏</text></view><text class="empty-text">暂无收藏</text><text class="empty-hint">浏览诗词时点击心形即可收藏</text></view><view class="list"><view wx:for="{{e}}" wx:for-item="p" wx:key="g" class="poem-card" bindtap="{{p.h}}"><view class="card-deco"><view class="deco-dot"/><view class="deco-line"/></view><view class="card-body"><view class="card-header"><text class="card-title">{{p.a}}</text><text class="card-dynasty">{{p.b}}</text></view><text class="card-author">{{p.c}}</text><text class="card-preview">{{p.d}}</text></view><view class="card-action" catchtap="{{p.f}}"><uni-icons wx:if="{{f}}" u-i="{{p.e}}" bind:__l="__l" u-p="{{f}}"/></view></view></view><view style="height:60rpx"/></scroll-view></view>