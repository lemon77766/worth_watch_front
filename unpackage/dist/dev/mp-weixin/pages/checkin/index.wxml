<view class="page"><view class="navbar"><view class="nav-btn" bindtap="{{b}}"><uni-icons wx:if="{{a}}" u-i="394b4c50-0" bind:__l="__l" u-p="{{a}}"/></view><text class="nav-title">每日打卡</text><view class="nav-btn"><uni-icons wx:if="{{c}}" u-i="394b4c50-1" bind:__l="__l" u-p="{{c}}"/></view></view><scroll-view scroll-y class="scroll-body"><view class="streak-card"><view class="flame-wrap"><view class="flame-bg"><text class="flame-icon">🔥</text></view></view><text class="streak-label">已连续研习</text><view class="streak-num-row"><text class="streak-num">{{d}}</text><text class="streak-unit">天</text></view></view><view class="section"><view class="cal-hd"><view class="mod-title-wrap"><view class="mod-bar"/><text class="cal-title">{{e}}年{{f}}月</text></view><view class="cal-nav"><view class="cal-nav-btn" bindtap="{{h}}"><uni-icons wx:if="{{g}}" u-i="394b4c50-2" bind:__l="__l" u-p="{{g}}"/></view><view class="cal-nav-btn" bindtap="{{j}}"><uni-icons wx:if="{{i}}" u-i="394b4c50-3" bind:__l="__l" u-p="{{i}}"/></view></view></view><view class="cal-card"><view class="cal-week-row"><text wx:for="{{k}}" wx:for-item="w" wx:key="b" class="cal-week">{{w.a}}</text></view><view class="cal-grid"><view wx:for="{{l}}" wx:for-item="d" wx:key="h" class="cal-cell"><view wx:if="{{d.a}}" class="{{['cal-day', d.e && 'day-checked', d.f && 'day-today', d.g && 'day-empty']}}"><text class="{{['cal-day-text', d.c && 'text-checked', d.d && 'text-today']}}">{{d.b}}</text></view></view></view></view><view class="legend-row"><view class="legend-item"><view class="legend-dot dot-checked"/><text class="legend-text">已打卡</text></view><view class="legend-item"><view class="legend-dot dot-today"/><text class="legend-text">今日</text></view><view class="legend-item"><view class="legend-dot dot-empty"/><text class="legend-text">未打卡</text></view></view></view><view class="section"><view class="mod-hd"><view class="mod-bar"/><text class="mod-title">打卡奖励</text></view><view class="reward-row"><view wx:for="{{m}}" wx:for-item="r" wx:key="c" class="{{['reward-card', r.d && 'reward-active']}}"><text class="reward-icon">🎖</text><text class="reward-days">{{r.a}}天</text><text class="reward-desc">{{r.b}}</text></view></view></view><view class="section"><view class="{{['checkin-btn', o && 'checked-btn']}}" bindtap="{{p}}"><text class="checkin-btn-text">{{n}}</text></view></view><view style="height:60rpx"/></scroll-view></view>