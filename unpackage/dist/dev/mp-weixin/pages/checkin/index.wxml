<view class="page"><view class="navbar"><view class="nav-btn" bindtap="{{b}}"><uni-icons wx:if="{{a}}" u-i="394b4c50-0" bind:__l="__l" u-p="{{a}}"/></view><text class="nav-title">每日打卡</text><view class="nav-btn"><uni-icons wx:if="{{c}}" u-i="394b4c50-1" bind:__l="__l" u-p="{{c}}"/></view></view><scroll-view scroll-y class="scroll-body"><view class="streak-card"><view class="flame-wrap"><view class="flame-bg"><text class="flame-icon">🔥</text></view></view><text class="streak-label">已连续研习</text><view class="streak-num-row"><text class="streak-num">{{d}}</text><text class="streak-unit">天</text></view></view><view class="section"><view class="cal-hd"><view class="mod-title-wrap"><view class="mod-bar"/><text class="cal-title">{{e}}年{{f}}月</text></view><view class="cal-nav"><view class="cal-nav-btn" bindtap="{{h}}"><uni-icons wx:if="{{g}}" u-i="394b4c50-2" bind:__l="__l" u-p="{{g}}"/></view><view class="cal-nav-btn" bindtap="{{j}}"><uni-icons wx:if="{{i}}" u-i="394b4c50-3" bind:__l="__l" u-p="{{i}}"/></view></view></view><view class="cal-card"><view class="cal-week-row"><text wx:for="{{k}}" wx:for-item="w" wx:key="b" class="cal-week">{{w.a}}</text></view><view class="cal-grid"><view wx:for="{{l}}" wx:for-item="d" wx:key="k" class="cal-cell"><view wx:if="{{d.a}}" class="{{['cal-day', d.f && 'day-checked', d.g && 'day-today', d.h && 'day-empty', d.i && 'day-selected']}}" bindtap="{{d.j}}"><text class="{{['cal-day-text', d.c && 'text-checked', d.d && 'text-today', d.e && 'text-selected']}}">{{d.b}}</text></view></view></view></view><view class="legend-row"><view class="legend-item"><view class="legend-dot dot-checked"/><text class="legend-text">已打卡</text></view><view class="legend-item"><view class="legend-dot dot-today"/><text class="legend-text">今日</text></view><view class="legend-item"><view class="legend-dot dot-empty"/><text class="legend-text">未打卡</text></view></view><view wx:if="{{m}}" class="day-poems"><view class="day-poems-hd"><text class="day-poems-title">{{n}}月{{o}}日 学习记录</text><view class="day-poems-close" bindtap="{{q}}"><uni-icons wx:if="{{p}}" u-i="394b4c50-4" bind:__l="__l" u-p="{{p}}"/></view></view><view wx:if="{{r}}" class="day-poem-list"><view wx:for="{{s}}" wx:for-item="p" wx:key="e" class="day-poem-item" bindtap="{{p.f}}"><view class="day-poem-icon"><uni-icons wx:if="{{t}}" u-i="{{p.a}}" bind:__l="__l" u-p="{{t}}"/></view><view class="day-poem-info"><text class="day-poem-name">《{{p.b}}》</text><text class="day-poem-author">{{p.c}}</text></view><uni-icons wx:if="{{v}}" u-i="{{p.d}}" bind:__l="__l" u-p="{{v}}"/></view></view><view wx:else class="day-poem-empty"><text class="day-poem-empty-text">当天无诗词学习记录</text></view></view></view><view class="section"><view class="{{['checkin-btn', x && 'checked-btn']}}" bindtap="{{y}}"><text class="checkin-btn-text">{{w}}</text></view></view><view style="height:60rpx"/></scroll-view></view>